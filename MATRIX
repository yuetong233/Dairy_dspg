library(tigris)
library(osrm)
library(sf)
vaco <- counties(state = 'VA')


latx <- c()
lonx <- c()
laty <- c()
lony <- c()

dairy.fips2 <- c(51015, 51043, 51067, 51143, 51163, 51165, 51171) # Augusta, Clarke, Franklin, Pittsylvania, Rockbridge, Rockingham, Shenandoah

for (d in dairy.fips2) {
  print(d)
  tmp <- vaco[which(vaco$GEOID == d),]
  for (i in 1:nrow(vaco)) {
    latx <- c(latx, as.numeric(tmp$INTPTLAT[1]))
    lonx <- c(lonx, as.numeric(tmp$INTPTLON[1]))
    laty <- c(laty, as.numeric(vaco$INTPTLAT[i]))
    lony <- c(lony, as.numeric(vaco$INTPTLON[i]))
  }
}

coordinates <- tibble(id = c(1:length(latx)), lat_x = latx, long_x = lonx, lat_y = laty, long_y = lony)


origin <-  coordinates %>% 
  # Subset your origin coordinates and the ID
  select(id, long_x, lat_x) %>% 
  # Rename the Variables 
  rename(lon = long_x, 
         lat = lat_x) %>% 
  # Convert to data.frame object
  as.data.frame()
destination <- coordinates %>% 
  # Subset your destination coordinates
  select(id, long_y, lat_y) %>% 
  # Rename the Variables
  rename(lon = long_y, 
         lat = lat_y) %>% 
  # Convert to data.frame object
  as.data.frame()


## Create an empty list to initialize the loop
commute_data <- list()

## Use For Loop to iterate over values and calculate commute distance and times
for (i in 1:nrow(coordinates)) {
  print(i)
  commute_data[[i]] <- osrmRoute(
    # Origin Points
    src = origin[i, 2:3], 
    # Destination Points
    dst = destination[i, 2:3],
    # Simplify output 
    overview = F, 
    # Set mode of transportation (car, bike, or foot)
    osrm.profile = "car"
  )
}
## Combine the list output from the for loop into a single data frame
commute_data <- as.data.frame(do.call(rbind, commute_data))

## Add ID variable back in 
commute_data$id <- coordinates$id
commute_data


