# Reload vaco with centroid-compatible shapes
vaco <- counties(state = 'VA', class = "sf") %>% st_transform(4326)

# Rockingham centroid
rockingham_coords <- vaco %>% filter(toupper(NAME) == "ROCKINGHAM")
x1 <- as.numeric(st_coordinates(st_centroid(rockingham_coords))[1])
y1 <- as.numeric(st_coordinates(st_centroid(rockingham_coords))[2])

# Richmond centroid
richmond_coords <- vaco %>% filter(GEOID == 51760)
x2 <- as.numeric(st_coordinates(st_centroid(richmond_coords))[1])
y2 <- as.numeric(st_coordinates(st_centroid(richmond_coords))[2])


# Slope and intercept of the line
m <- (y2 - y1) / (x2 - x1)
b <- y1 - m * x1

# Generate interpolation points
weights <- 0:100
interpolation_df <- data.frame(
  weight = weights,
  w = weights / 100
) %>%
  mutate(
    x = w * x1 + (1 - w) * x2,
    y = m * x + b
  )


# Convert to sf object
interpolation_sf <- st_as_sf(interpolation_df, coords = c("x", "y"), crs = 4326)

# Load county shapes
vaco <- counties(state = 'VA', cb = TRUE, class = "sf") %>%
  st_transform(4326)

